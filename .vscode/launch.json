{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Air Webapp: Debug in Chrome",
            "type": "chrome",
            "request": "launch",
            "url": "https://localhost:5173",
            "webRoot": "${workspaceFolder}/apps/air-webapp",
            "preLaunchTask": "air-webapp: dev"
        },
        {
            "name": "Android Shell: Install, Launch & Inspect",
            "type": "chrome",
            "request": "launch",
            "url": "chrome://inspect/#devices",
            "webRoot": "${workspaceFolder}/apps/air-webapp",
            "preLaunchTask": "android-shell: install & launch"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Ground: Debug (Tailscale)",
            "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/tsx",
            "program": "${workspaceFolder}/apps/ground-core-node/src/index.ts",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "env": {
                "SIGNAL_HOST": "desktop-cradle.tail70570b.ts.net",
                "TLS_PROVIDER": "tailscale"
            },
            "cwd": "${workspaceFolder}/apps/ground-core-node",
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Ground: Debug (Local)",
            "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/tsx",
            "program": "${workspaceFolder}/apps/ground-core-node/src/index.ts",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "env": {
                "SIGNAL_HOST": "192.168.0.150",
            },
            "cwd": "${workspaceFolder}/apps/ground-core-node",
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Ground: Debug (Local) with fixed QR",
            "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/tsx",
            "program": "${workspaceFolder}/apps/ground-core-node/src/index.ts",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "env": {
                "SIGNAL_HOST": "192.168.0.150",
                "PAIRING_SESSION_ID": "43f857cb-9b86-4ce2-95af-c9d728a0a70d",
                "PAIRING_TOKEN": "-PgWRYm65AHGh_-bWvzn0Q",
            },
            "cwd": "${workspaceFolder}/apps/ground-core-node",
            "skipFiles": [
                "<node_internals>/**"
            ]
        }
    ]
}
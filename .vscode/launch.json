{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Air Webapp: Debug in Chrome",
            "type": "chrome",
            "request": "launch",
            "url": "https://localhost:5173",
            "webRoot": "${workspaceFolder}/apps/air-webapp",
            "preLaunchTask": "air-webapp: dev"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Ground: Debug",
            "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/tsx",
            "program": "${workspaceFolder}/apps/ground-core-node/src/index.ts",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "env": {
                "SIGNAL_HOST": "desktop-cradle.tail70570b.ts.net",
                "TLS_PROVIDER": "tailscale"
            },
            "cwd": "${workspaceFolder}/apps/ground-core-node",
            "skipFiles": [
                "<node_internals>/**"
            ]
        }
    ]
}
{
  "name": "@dronelink/air-webapp",
  "version": "0.1.0",
  "description": "Air-side PWA composition shell",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@dronelink/air-client-sdk": "file:../../packages/air-client-sdk",
    "@dronelink/ui-kit-shared": "file:../../packages/ui-kit-shared",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/w3c-web-serial": "^1.0.8",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.0.0",
    "typescript": "^5.9.2",
    "vite": "^8.1.5",
    "vite-plugin-mkcert": "^2.1.0",
    "vitest": "^4.1.10"
  }
}

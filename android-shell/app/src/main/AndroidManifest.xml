<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!--
      The service exists to keep the process alive while bridging the USB-connected
      flight controller and streaming its video out — connectedDevice is the FGS type
      matching that purpose.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      Lets AirShellForegroundService's full-screen intent actually launch MainActivity
      unattended after BOOT_COMPLETED (see AirShellForegroundService.startForegroundWithNotification).
      Auto-granted below API 34; on API 34+ this is restricted to alarm/calling-style
      apps by default and may need the user to enable "Full screen notifications" for
      this app under Settings — a real-device check for spike 5, not something a manifest
      declaration alone guarantees.
    -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!--
      required="false": USB host mode isn't universal (see spikes/README.md
      "Emulator vs. real device"), and we don't want to block installation on
      devices that lack it — Spikes 1-3 still function without it.
    -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.AndroidShell">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              Lets attaching a matching USB device (see xml/device_filter) launch
              MainActivity directly even while the app isn't running — this is a
              system-level exemption from the usual background-activity-start
              restrictions, distinct from (and in addition to) BootUsbReceiver's
              plain broadcast handling of the same action, which only starts the
              foreground service and can't itself start an Activity from the
              background. Covers "USB attached while the phone is already
              unlocked/running"; BOOT_COMPLETED-with-USB-already-attached (no live
              attach event) is covered instead by the foreground service's
              full-screen intent.
            -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>

        <service
            android:name=".AirShellForegroundService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!--
          BOOT_COMPLETED and USB_DEVICE_ATTACHED are both exempted from Android's
          implicit-broadcast and background-start restrictions specifically to
          support this autostart pattern, so a manifest-registered receiver works
          even when the app isn't already running.
        -->
        <receiver
            android:name=".BootUsbReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dronelink.local/protocol/schemas/pairing-bundle.schema.json",
  "title": "Pairing Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["sessionId", "token", "host", "port"],
  "properties": {
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$"
    },
    "host": {
      "type": "string",
      "minLength": 1
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dronelink.local/protocol/schemas/video-control-state.schema.json",
  "title": "Video Control State",
  "description": "Air-to-ground acknowledgment of an applied video control, forwarded to any connected GUI viewer. The `control` field discriminates the payload shape; \"quality\", \"camera-source\", \"camera-set-default\", \"flip\", and \"rotate\" are defined today, mirroring video-control-request.schema.json. \"camera-source-list\" is a related but unsolicited push (not an ack to any request) reporting air's enumerated cameras, which one is active, which one is saved as the default, and the active camera's own current flip/rotation (each camera can have its own saved transform, so a switch can change this without a direct flip/rotate request) -- sent after every switch so a GUI viewer's flip checkboxes/rotation label can stay in sync with whichever camera is actually active.",
  "type": "object",
  "oneOf": [
    {
      "additionalProperties": false,
      "required": ["type", "control", "preset", "videoActive"],
      "properties": {
        "type": { "const": "video-control-state" },
        "control": { "const": "quality" },
        "preset": { "enum": ["auto", "high", "low", "data-only"] },
        "videoActive": { "type": "boolean" }
      }
    },
    {
      "additionalProperties": false,
      "required": ["type", "control", "deviceId", "ok"],
      "properties": {
        "type": { "const": "video-control-state" },
        "control": { "const": "camera-source" },
        "deviceId": { "type": "string", "minLength": 1 },
        "ok": { "type": "boolean" },
        "error": { "type": "string" }
      }
    },
    {
      "additionalProperties": false,
      "required": ["type", "control", "deviceId", "ok"],
      "properties": {
        "type": { "const": "video-control-state" },
        "control": { "const": "camera-set-default" },
        "deviceId": { "type": "string", "minLength": 1 },
        "ok": { "type": "boolean" },
        "error": { "type": "string" }
      }
    },
    {
      "additionalProperties": false,
      "required": ["type", "control", "horizontal", "vertical", "ok"],
      "properties": {
        "type": { "const": "video-control-state" },
        "control": { "const": "flip" },
        "horizontal": { "type": "boolean" },
        "vertical": { "type": "boolean" },
        "ok": { "type": "boolean" },
        "error": { "type": "string" }
      }
    },
    {
      "additionalProperties": false,
      "required": ["type", "control", "degrees", "ok"],
      "properties": {
        "type": { "const": "video-control-state" },
        "control": { "const": "rotate" },
        "degrees": { "enum": [0, 90, 180, 270] },
        "ok": { "type": "boolean" },
        "error": { "type": "string" }
      }
    },
    {
      "additionalProperties": false,
      "required": ["type", "control", "devices", "activeDeviceId", "defaultDeviceId", "activeTransform"],
      "properties": {
        "type": { "const": "video-control-state" },
        "control": { "const": "camera-source-list" },
        "devices": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["deviceId", "label"],
            "properties": {
              "deviceId": { "type": "string" },
              "label": { "type": "string" }
            }
          }
        },
        "activeDeviceId": { "type": ["string", "null"] },
        "defaultDeviceId": { "type": ["string", "null"] },
        "activeTransform": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["horizontal", "vertical", "rotation"],
          "properties": {
            "horizontal": { "type": "boolean" },
            "vertical": { "type": "boolean" },
            "rotation": { "enum": [0, 90, 180, 270] }
          }
        }
      }
    }
  ]
}
